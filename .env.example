# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (anti-spam). Outside production, Cloudflare test keys are used if empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (lead emails). If empty, leads are still saved and shown in the dashboard.
RESEND_API_KEY=
# Sender, e.g. "DiveAdvisor <contatti@yourdomain.it>" (domain must be verified in Resend)
LEAD_EMAIL_FROM=
# Inbox that receives leads for [TEST] centres (and all leads if LEAD_EMAIL_FORCE_OVERRIDE=1)
LEAD_EMAIL_OVERRIDE=
LEAD_EMAIL_FORCE_OVERRIDE=
# Team inbox for review moderation and reports. Falls back to LEAD_EMAIL_OVERRIDE if empty.
ADMIN_EMAIL=
# Public site URL used in emails (e.g. https://dive-advisor.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Playwright only: password of the e2e test users (see docs/DEVLOG.md), optional preview URL and bypass secret
E2E_PASSWORD=
E2E_BASE_URL=
VERCEL_SHARE_TOKEN=
